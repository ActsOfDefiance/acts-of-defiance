---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryTiles from "../components/CategoryTiles.astro";
import Prose from "../components/Prose.astro";
import SectionHead from "../components/SectionHead.astro";

const entry = await getEntry("about", "index");
if (!entry) {
  throw new Error("Missing src/content/about/index.md");
}
const { Content } = await render(entry);
---

<BaseLayout
  title="About"
  description={entry.data.tagline}
  mainClass=""
  bodyClass="bg-[#fff9ec]"
>
  <!-- Cinematic hero — slides behind fixed nav, same treatment as the article page -->
  <header slot="hero" class="relative w-full aspect-[21/9] overflow-hidden bg-surface-container-highest">
    <div class="absolute inset-0 sunburst-bg opacity-40"></div>
    <div class="absolute inset-0 flex items-center justify-center">
      <span
        class="text-[20vw] font-black uppercase leading-none text-[#d4a843]/20 select-none"
        style="font-family: var(--font-headline)"
      >
        AoD
      </span>
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#1A1A1A] via-transparent to-transparent"></div>
  </header>

  <!-- Main content overlaps hero by 24 -->
  <div class="max-w-screen-xl mx-auto px-6 -mt-24 relative z-10">

    <!-- Page header: white card -->
    <div class="bg-white p-8 md:p-12 shadow-sm">
      <div class="flex flex-col items-start gap-4">
        <!-- Headline -->
        <h1
          class="uppercase tracking-tighter max-w-4xl text-[#1c1b1b]"
          style="font-family: var(--font-headline); font-size: var(--text-h1); line-height: 1"
        >
          {entry.data.title}
        </h1>
        <!-- Tagline -->
        <p
          class="italic text-[#4e4636] max-w-3xl"
          style="font-family: var(--font-label); font-size: var(--text-body-lg)"
        >
          {entry.data.tagline}
        </p>
      </div>
    </div>

    <!-- Manifesto body — shared Prose component (no page-level scoped CSS) -->
    <article class="bg-[#F5EDD6] py-16 md:py-24 px-6 md:px-0">
      <Prose>
        <Content />
      </Prose>
    </article>

    <!-- What we cover — category tile grid -->
    <section class="py-24 border-t border-[#d2c5b1]">
      <SectionHead variant="editorial" class="mb-12 text-center">
        What we cover
      </SectionHead>
      <CategoryTiles />
    </section>

  </div><!-- /max-w-screen-xl -->
</BaseLayout>
