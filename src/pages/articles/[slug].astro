---
import { getCollection, render } from "astro:content";
import { marked } from "marked";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleContent from "../../components/ArticleContent.svelte";
import SectionHead from "../../components/SectionHead.astro";
import { CATEGORIES, badgeStyle, type CategorySlug } from "../../lib/categories";
import Container from "../../components/layout/Container.astro";
import Stack from "../../components/layout/Stack.astro";
import Cluster from "../../components/layout/Cluster.astro";
import Grid from "../../components/layout/Grid.astro";

export async function getStaticPaths() {
  // Exclude drafts — drafts must not be reachable at /articles/[slug] in
  // production builds. Matches the filter used by home and category pages.
  const articles = await getCollection("articles", ({ data }) => !data.draft);

  // Compute the related-articles list here once per path so it can be
  // passed as a prop. Otherwise the article page would re-fetch and
  // re-filter the entire collection for each static page at render time.
  return articles.map((article) => ({
    params: { slug: article.id },
    props: {
      article,
      related: articles
        .filter((a) => a.id !== article.id && a.data.category !== undefined && a.data.category === article.data.category)
        .slice(0, 3),
    },
  }));
}

// Default `related` to an empty array so the page renders safely if the
// dev server's content collection cache goes stale between HMR passes.
const { article, related = [] } = Astro.props;

// Split raw markdown body at structural markers.
// "# TLDR" and "# Research" are section delimiters — omitted from rendered output.
const body = article.body ?? '';
const tldrMatch = body.match(/^#\s*TLDR\s*$/m);
const researchMatch = body.match(/^#\s*Research\s*$/m);

const storyMd = (tldrMatch && researchMatch)
  ? body.slice(tldrMatch.index! + tldrMatch[0].length, researchMatch.index).trim()
  : '';

const deepMd = researchMatch
  ? body.slice(researchMatch.index! + researchMatch[0].length).trim()
  : body.trim();

const storyHtml = String(marked.parse(storyMd));
const deepHtml = String(marked.parse(deepMd));

// Single source of truth for badge + tint comes from src/lib/categories.ts.
// `badge` is the inline-style string for the category pill; `tintFor()` returns
// the related-card overlay tint. No local color mapping — see categories.ts.
const badge = badgeStyle(article.data.category);
const tintFor = (slug: string) => {
  const cat = CATEGORIES[slug as CategorySlug];
  // Fallback references the deep-charcoal token via its CSS custom property
  // so there is no literal hex anywhere in the page.
  return cat ? `background:${cat.accent}` : "background:var(--color-deep-charcoal)";
};

const dateStr = article.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={article.data.title} description={article.data.description} mainClass="" bodyClass="bg-background-warm">

  <!-- Cinematic hero: aspect-[21/9], slides behind fixed nav -->
  <header slot="hero" class="relative w-full aspect-[21/9] overflow-hidden bg-surface-container-highest">
    <div class="absolute inset-0 sunburst-bg opacity-40"></div>
    {article.data.images?.hero ? (
      <img
        src={`/images/articles/${article.data.images.hero}`}
        alt={article.data.title}
        class="w-full h-full object-cover object-center mix-blend-multiply opacity-90"
      />
    ) : (
      <div class="absolute inset-0 flex items-center justify-center">
        <span
          class="text-[20vw] font-black uppercase leading-none text-warm-gold/20 select-none"
          style="font-family: var(--font-headline)"
        >
          AoD
        </span>
      </div>
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-deep-charcoal via-transparent to-transparent"></div>
  </header>

  <!-- Main content overlaps hero -->
  <Container class="relative z-10 -mt-3xl">

    <!-- Article header: white card -->
    <div class="bg-white p-lg md:p-xl shadow-sm">
      <Stack gap="sm" class="items-start">

        <!-- Category pill — stamps in on page load via .motion-stamp-in -->
        <span
          class="motion-stamp-in px-sm py-3xs font-black uppercase tracking-widest rounded-full"
          style={`font-family: var(--font-headline); font-size: var(--text-caption); ${badge}`}
        >
          {CATEGORIES[article.data.category as CategorySlug]?.name ?? article.data.category}
        </span>

        <!-- Headline -->
        <h1
          class="uppercase tracking-tighter max-w-hero text-on-surface"
          style="font-family: var(--font-headline); font-size: var(--text-h1); line-height: 1"
        >
          {article.data.title}
        </h1>

        <!-- Date + tags row -->
        <Cluster gap="sm" align="center" class="text-on-surface-variant mt-sm" style="font-size: var(--text-caption)">
          <span style="font-family: var(--font-label)" class="italic">
            {dateStr}
          </span>
          {article.data.tags.length > 0 && (
            <Cluster gap="2xs">
              {article.data.tags.map((tag) => (
                <span
                  class="px-2xs py-3xs bg-surface-container-high uppercase font-bold tracking-tight text-on-surface-variant"
                  style="font-size: var(--text-caption)"
                >
                  {tag}
                </span>
              ))}
            </Cluster>
          )}
        </Cluster>
      </Stack>

    </div>

    <ArticleContent {storyHtml} {deepHtml} client:load />

    <!-- Related articles -->
    {related.length > 0 && (
      <section class="py-section-y border-t border-outline-variant">
        <div class="mb-xl">
          <SectionHead variant="structural">More acts of defiance</SectionHead>
        </div>
        <Grid cols="1 md:3" gap="lg">
          {related.map((rel) => {
            const tint = tintFor(rel.data.category ?? "");
            const relBadge = badgeStyle(rel.data.category);
            const relCat = CATEGORIES[rel.data.category as CategorySlug];
            return (
              <a href={`/articles/${rel.id}`} class="aod-brand-card aod-focus-ring group cursor-pointer block">
                <div class="aspect-[4/5] bg-surface-container-highest relative overflow-hidden mb-md">
                  {rel.data.images?.hero ? (
                    <img
                      src={`/images/articles/${rel.data.images.hero}`}
                      alt={rel.data.title}
                      class="aod-brand-card__image w-full h-full object-cover"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center">
                      <span class="text-8xl font-black uppercase text-warm-gold/20 select-none" style="font-family: var(--font-headline)">AoD</span>
                    </div>
                  )}
                  <div
                    class="absolute inset-0 mix-blend-multiply opacity-20 group-hover:opacity-0"
                    style={`${tint}; transition: opacity var(--duration-quick) var(--ease-manifesto)`}
                  ></div>
                  <div class="absolute bottom-md left-md right-md">
                    <span
                      class="px-xs py-3xs font-black uppercase tracking-widest rounded-none"
                      style={`font-family: var(--font-headline); font-size: var(--text-caption); ${relBadge}`}
                    >
                      {relCat?.name ?? rel.data.category}
                    </span>
                    <h4
                      class="aod-brand-card__title text-white uppercase mt-2xs drop-shadow-lg"
                      style="font-family: var(--font-headline); font-size: var(--text-h4); line-height: 1"
                    >
                      {rel.data.title}
                    </h4>
                  </div>
                </div>
              </a>
            );
          })}
        </Grid>
      </section>
    )}

  </Container>

</BaseLayout>
