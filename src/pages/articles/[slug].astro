---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Prose from "../../components/Prose.astro";
import SectionHead from "../../components/SectionHead.astro";
import { CATEGORIES, badgeStyle, type CategorySlug } from "../../lib/categories";

export async function getStaticPaths() {
  // Exclude drafts — drafts must not be reachable at /articles/[slug] in
  // production builds. Matches the filter used by home and category pages.
  const articles = await getCollection("articles", ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

// Related articles — same category, excluding self
const allArticles = await getCollection("articles", ({ data }) => !data.draft);
const related = allArticles
  .filter((a) => a.id !== article.id && a.data.category === article.data.category)
  .slice(0, 3);

// Single source of truth for badge + tint comes from src/lib/categories.ts.
// `badge` is the inline-style string for the category pill; `tintFor()` returns
// the related-card overlay tint. No local color mapping — see categories.ts.
const badge = badgeStyle(article.data.category);
const tintFor = (slug: string) => {
  const cat = CATEGORIES[slug as CategorySlug];
  return cat ? `background:${cat.accent}` : "background:#1a1a1a";
};

const dateStr = article.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={article.data.title} description={article.data.description} mainClass="" bodyClass="bg-[#fff9ec]">

  <!-- Cinematic hero: aspect-[21/9], slides behind fixed nav -->
  <header slot="hero" class="relative w-full aspect-[21/9] overflow-hidden bg-surface-container-highest">
    <div class="absolute inset-0 sunburst-bg opacity-40"></div>
    {article.data.images?.hero ? (
      <img
        src={`/images/articles/${article.data.images.hero}`}
        alt={article.data.title}
        class="w-full h-full object-cover object-center mix-blend-multiply opacity-90"
      />
    ) : (
      <div class="absolute inset-0 flex items-center justify-center">
        <span
          class="text-[20vw] font-black uppercase leading-none text-warm-gold/20 select-none"
          style="font-family: var(--font-headline)"
        >
          AoD
        </span>
      </div>
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-[#1A1A1A] via-transparent to-transparent"></div>
  </header>

  <!-- Main content overlaps hero by 24 -->
  <div class="max-w-screen-xl mx-auto px-6 -mt-24 relative z-10">

    <!-- Article header: white card -->
    <div class="bg-white p-8 md:p-12 shadow-sm">
      <div class="flex flex-col items-start gap-4">

        <!-- Category pill -->
        <span
          class="px-4 py-1 font-black uppercase tracking-widest rounded-full"
          style={`font-family: var(--font-headline); font-size: var(--text-caption); ${badge}`}
        >
          {CATEGORIES[article.data.category as CategorySlug]?.name ?? article.data.category}
        </span>

        <!-- Headline -->
        <h1
          class="uppercase tracking-tighter max-w-4xl text-on-surface"
          style="font-family: var(--font-headline); font-size: var(--text-h1); line-height: 1"
        >
          {article.data.title}
        </h1>

        <!-- Date + tags row -->
        <div class="flex flex-wrap items-center gap-4 text-on-surface-variant mt-4" style="font-size: var(--text-caption)">
          <span style="font-family: var(--font-label)" class="italic">
            {dateStr}
          </span>
          {article.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {article.data.tags.map((tag) => (
                <span
                  class="px-2 py-0.5 bg-surface-container-high uppercase font-bold tracking-tight text-on-surface-variant"
                  style="font-size: var(--text-caption)"
                >
                  {tag}
                </span>
              ))}
            </div>
          )}
        </div>
      </div>

      <!-- Content version selector -->
      <div class="flex gap-4 mt-12 border-t border-[#d2c5b1] pt-8">
        <!-- Short Read (inactive) -->
        <div class="flex-1 text-left p-6 bg-[#f6eed7] text-[#1f1c0e] cursor-default">
          <div class="uppercase font-bold tracking-widest opacity-60 mb-2" style="font-family: var(--font-headline); font-size: var(--text-caption)">
            Short Read
          </div>
          <div class="font-bold leading-tight" style="font-family: var(--font-headline); font-size: var(--text-body-lg)">
            The Story
          </div>
          <div class="h-1 w-0 bg-[#d4a843] mt-4"></div>
        </div>
        <!-- Deep Dive (active) -->
        <div class="flex-1 text-left p-6 bg-white border-b-4 border-[#d4a843] shadow-md cursor-default">
          <div class="uppercase font-bold tracking-widest text-[#795900] mb-2" style="font-family: var(--font-headline); font-size: var(--text-caption)">
            Full Research
          </div>
          <div class="font-bold leading-tight text-[#1f1c0e]" style="font-family: var(--font-headline); font-size: var(--text-body-lg)">
            Deep Dive
          </div>
          <div class="h-1 w-full bg-[#d4a843] mt-4"></div>
        </div>
      </div>
    </div>

    <!-- Article body: parchment background -->
    <article class="bg-[#F5EDD6] py-16 md:py-24 px-6 md:px-0">
      <Prose>
        <Content />
      </Prose>
    </article>

    <!-- Related articles -->
    {related.length > 0 && (
      <section class="py-24 border-t border-outline-variant">
        <div class="mb-12">
          <SectionHead variant="structural">More acts of defiance</SectionHead>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {related.map((rel) => {
            const tint = tintFor(rel.data.category);
            const relBadge = badgeStyle(rel.data.category);
            const relCat = CATEGORIES[rel.data.category as CategorySlug];
            return (
              <a href={`/articles/${rel.id}`} class="group cursor-pointer block">
                <div class="aspect-[4/5] bg-surface-container-highest relative overflow-hidden mb-6">
                  {rel.data.images?.hero ? (
                    <img
                      src={`/images/articles/${rel.data.images.hero}`}
                      alt={rel.data.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center">
                      <span class="text-8xl font-black uppercase text-warm-gold/20 select-none" style="font-family: var(--font-headline)">AoD</span>
                    </div>
                  )}
                  <div
                    class="absolute inset-0 mix-blend-multiply opacity-20 group-hover:opacity-0 transition-opacity"
                    style={tint}
                  ></div>
                  <div class="absolute bottom-6 left-6 right-6">
                    <span
                      class="px-3 py-1 font-black uppercase tracking-widest rounded-none"
                      style={`font-family: var(--font-headline); font-size: var(--text-caption); ${relBadge}`}
                    >
                      {relCat?.name ?? rel.data.category}
                    </span>
                    <h4
                      class="text-white uppercase mt-2 drop-shadow-lg"
                      style="font-family: var(--font-headline); font-size: var(--text-h4); line-height: 1"
                    >
                      {rel.data.title}
                    </h4>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

  </div><!-- /max-w-screen-xl -->

</BaseLayout>
