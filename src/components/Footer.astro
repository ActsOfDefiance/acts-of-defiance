---
import { CATEGORY_LIST } from "../lib/categories";

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  return currentPath === href || currentPath.startsWith(href + "/");
}

// Footer link set: About first, then the four categories from the
// single source of truth in src/lib/categories.ts.
const footerLinks = [
  { label: "About", href: "/about" },
  ...CATEGORY_LIST.map((cat) => ({
    label: cat.name,
    href: `/categories/${cat.slug}`,
  })),
];
---

<footer class="bg-deep-charcoal text-white py-16 px-8">
  <div class="max-w-4xl mx-auto text-center space-y-8">
    <p
      class="italic text-warm-gold"
      style="font-family: var(--font-label); font-size: var(--text-body-lg)"
    >
      Remembering those whose very existence defied injustice.
    </p>
    <nav class="flex flex-wrap justify-center gap-8" aria-label="Footer navigation">
      {footerLinks.map((link) => {
        const active = isActive(link.href);
        return (
          <a
            href={link.href}
            aria-current={active ? "page" : undefined}
            class:list={[
              "uppercase tracking-wide transition-colors rounded-sm",
              "focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-warm-gold",
              {
                "text-warm-gold font-bold": active,
                "text-white/70 hover:text-warm-gold": !active,
              },
            ]}
            style="font-family: var(--font-headline); font-size: var(--text-caption)"
          >
            {link.label}
          </a>
        );
      })}
    </nav>
  </div>
</footer>
