---
// SectionHead — the only sanctioned way to render an <h2> section heading.
//
// Two variants, both at the same scale step (--text-h2):
//
//   editorial   — italic Newsreader serif. Used to introduce a list of content
//                 in the editorial voice (Recent stories, What we cover, Go deeper).
//
//   structural  — Montserrat black uppercase. Used for closing/CTA section heads
//                 at the bottom of a page (More acts of defiance, Join the Defiance).
//
// See docs/specs/typography.md for the full rule.

interface Props {
  variant: "editorial" | "structural";
  /** Optional id for in-page anchors. */
  id?: string;
  /** Optional className for layout/positioning (margin, alignment, color override). */
  class?: string;
}

const { variant, id, class: classOverride = "" } = Astro.props;

const variantClass =
  variant === "editorial"
    ? "section-head--editorial"
    : "section-head--structural";
---

<h2 id={id} class={`section-head ${variantClass} ${classOverride}`}>
  <slot />
</h2>

<style>
  .section-head {
    font-size: var(--text-h2);
    line-height: 1.05;
  }

  .section-head--editorial {
    font-family: var(--font-label);
    font-weight: 400;
    font-style: italic;
    text-transform: none;
    letter-spacing: 0;
    color: var(--color-deep-charcoal);
  }

  .section-head--structural {
    font-family: var(--font-headline);
    font-weight: 900;
    font-style: normal;
    text-transform: uppercase;
    letter-spacing: -0.025em;
    color: var(--color-deep-charcoal);
  }
</style>
