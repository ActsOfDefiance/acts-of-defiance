---
import type { CollectionEntry } from "astro:content";
import { badgeStyle, CATEGORIES, type CategorySlug } from "../lib/categories";
import Stack from "./layout/Stack.astro";
import Cluster from "./layout/Cluster.astro";

interface Props {
  article: CollectionEntry<"articles">;
  /** When true (category page) renders the heavy 4px black border accent. Default false. */
  bordered?: boolean;
  /** Index used to cycle through the 6 placeholder background colors on category pages. */
  variant?: number;
}

// Six-color cycle from the v2 category comp — alternates through the
// brand palette so a grid of same-category cards reads visually varied.
// Values are CSS var references so the palette stays in sync with the
// design tokens in global.css @theme.
const PLACEHOLDER_PALETTE = [
  "var(--color-primary)",                   // primary red (revolutionary-red)
  "var(--color-tertiary)",                  // tertiary teal (movement-teal)
  "var(--color-primary-md)",                // secondary amber
  "var(--color-primary-container-light)",   // lighter red
  "var(--color-tertiary-container-light)",  // lighter teal
  "var(--color-secondary-container-light)", // lighter gold
];

const { article, bordered = false, variant } = Astro.props;
const cat = CATEGORIES[article.data.category as CategorySlug];
const placeholderBg =
  variant !== undefined
    ? PLACEHOLDER_PALETTE[variant % PLACEHOLDER_PALETTE.length]
    : (cat?.accent ?? "var(--color-deep-charcoal)");
---

<a
  href={`/articles/${article.id}`}
  class="aod-brand-card aod-focus-ring flex flex-col group cursor-pointer rounded-lg bg-white"
>
  <div
    class:list={[
      "aspect-[4/5] overflow-hidden relative",
      {
        "border-4 border-deep-charcoal": bordered,
        "rounded-lg shadow-xl": !bordered,
      },
    ]}
    style={`background:${placeholderBg}`}
  >
    {article.data.images?.hero ? (
      <img
        src={`/images/articles/${article.data.images.hero}`}
        alt={article.data.title}
        class="aod-brand-card__image w-full h-full object-cover"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center">
        <span
          class="text-9xl font-black uppercase text-white/20 select-none"
          style="font-family: var(--font-headline)"
        >
          AoD
        </span>
      </div>
    )}
    <div class="absolute top-sm left-sm">
      <span
        class="px-xs py-3xs rounded-sm font-bold uppercase tracking-widest"
        style={`font-family: var(--font-headline); font-size: var(--text-caption); ${badgeStyle(article.data.category)}`}
      >
        {cat?.name ?? article.data.category}
      </span>
    </div>
  </div>
  <div style="height: 10rem; overflow: hidden">
  <Stack gap="xs" class="px-md pb-md pt-sm">
    <h3
      class="aod-brand-card__title line-clamp-2 uppercase tracking-tight text-deep-charcoal"
      style="font-family: var(--font-headline); font-size: var(--text-h4); line-height: 1.05"
    >
      {article.data.title}
    </h3>
    <p
      class="text-deep-charcoal/70 line-clamp-2 italic"
      style="font-family: var(--font-label); font-size: var(--text-body-lg); line-height: 1.4"
    >
      {article.data.description}
    </p>
  </Stack>
  </div>
</a>
