---
import type { CollectionEntry } from "astro:content";
import { badgeStyle, CATEGORIES, type CategorySlug } from "../lib/categories";

interface Props {
  article: CollectionEntry<"articles">;
  /** When true (category page) renders the heavy 4px black border accent. Default false. */
  bordered?: boolean;
  /** Index used to cycle through the 6 placeholder background colors on category pages. */
  variant?: number;
}

// Six-color cycle from the comp's category page — alternates through
// the brand palette so a grid of same-category cards reads visually varied.
const PLACEHOLDER_PALETTE = [
  "#c23b22", // primary red
  "#2a7b88", // tertiary teal
  "#795900", // secondary amber
  "#e57b66", // primary-container (lighter red)
  "#7fb5be", // tertiary-container (lighter teal)
  "#fece65", // secondary-container (lighter gold)
];

const { article, bordered = false, variant } = Astro.props;
const cat = CATEGORIES[article.data.category as CategorySlug];
const placeholderBg =
  variant !== undefined
    ? PLACEHOLDER_PALETTE[variant % PLACEHOLDER_PALETTE.length]
    : (cat?.accent ?? "#1a1a1a");
---

<a
  href={`/articles/${article.id}`}
  class="flex flex-col gap-6 group cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-revolutionary-red rounded-sm"
>
  <div
    class={[
      "aspect-[4/5] overflow-hidden relative",
      bordered ? "border-4 border-deep-charcoal" : "rounded-lg shadow-xl",
    ].join(" ")}
    style={`background:${placeholderBg}`}
  >
    {article.data.images?.hero ? (
      <img
        src={`/images/articles/${article.data.images.hero}`}
        alt={article.data.title}
        class="w-full h-full object-cover mix-blend-multiply opacity-90 group-hover:scale-105 transition-transform duration-500"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center">
        <span
          class="text-9xl font-black uppercase text-white/20 select-none"
          style="font-family: var(--font-headline)"
        >
          AoD
        </span>
      </div>
    )}
    <div class="absolute top-4 left-4">
      <span
        class="px-3 py-1 rounded-sm font-bold uppercase tracking-widest"
        style={`font-family: var(--font-headline); font-size: var(--text-caption); ${badgeStyle(article.data.category)}`}
      >
        {cat?.name ?? article.data.category}
      </span>
    </div>
  </div>
  <div class="space-y-3">
    <h3
      class="uppercase tracking-tight text-deep-charcoal group-hover:text-revolutionary-red transition-colors"
      style="font-family: var(--font-headline); font-size: var(--text-h4); line-height: 1.05"
    >
      {article.data.title}
    </h3>
    <p
      class="text-deep-charcoal/70 line-clamp-2 italic"
      style="font-family: var(--font-label); font-size: var(--text-body-lg); line-height: 1.4"
    >
      {article.data.description}
    </p>
    {article.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 pt-1">
        {article.data.tags.map((tag) => (
          <span
            class="font-bold uppercase tracking-tighter text-deep-charcoal/60"
            style="font-size: var(--text-caption)"
          >
            #{tag}
          </span>
        ))}
      </div>
    )}
  </div>
</a>
